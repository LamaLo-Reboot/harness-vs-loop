# Copy this file to .env. Where the model runs: engine | ollama | fake
BACKEND=fake

# The engine (cloud models). Needs a key: contact lamalo.ai.
ENGINE_URL=http://localhost:8088
ENGINE_KEY=
ENGINE_DEFAULT_MODEL=anthropic/claude-sonnet-5-5

# Ollama (a local model, no network)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# The fake engine: uv run uvicorn fake_engine.main:app --port 8089
FAKE_ENGINE_URL=http://localhost:8089
